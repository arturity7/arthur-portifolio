# Chave da API do Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Para onde as mensagens do formulário de contato serão enviadas
CONTACT_TO_EMAIL=seu-email@exemplo.com

# Remetente (opcional). Sem domínio verificado no Resend, use o padrão abaixo.
CONTACT_FROM_EMAIL="Portfólio <onboarding@resend.dev>"
